{
    "name": "docs",
    "version": "0.0.0",
    "private": true,
    "description": "Documentation website for the ATMO game engine.",
    "type": "module",
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vitepress dev",
        "build": "vitepress build",
        "preview": "vitepress preview",
        "api": "tsx scripts/api.ts",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm format:check && pnpm typecheck && pnpm test"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "devDependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/nunito-sans": "^5.3.0",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^26.6.5",
        "fast-xml-parser": "^5.11.2",
        "gray-matter": "^4.0.3",
        "markdown-it": "14.3.2",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vitepress": "1.6.4",
        "vitest": "^5.0.4",
        "vue": "^3.5.43",
        "vue-tsc": "^3.3.13"
    }
}
